<Window x:Class="Folderly.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Folderly.App.Infrastructure"
        Title="{Binding L[SettingsTitle]}"
        Width="500" Height="680"
        MinHeight="500" MinWidth="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI Variable">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,20">
                <TextBlock Text="{Binding L[LanguageSection]}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>

                <RadioButton Content="{Binding L[LanguageSystem]}"
                             IsChecked="{Binding IsSystemLang}"
                             Margin="0,0,0,4" FontSize="13"/>
                <RadioButton Content="{Binding L[LanguageJapanese]}"
                             IsChecked="{Binding IsJaLang}"
                             Margin="0,0,0,4" FontSize="13"/>
                <RadioButton Content="{Binding L[LanguageEnglish]}"
                             IsChecked="{Binding IsEnLang}"
                             Margin="0,0,0,0" FontSize="13"/>

                <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}"/>

                <TextBlock Text="{Binding L[HistorySection]}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>

                <Button Content="{Binding L[DeleteHistory]}"
                        Style="{StaticResource SecondaryButton}"
                        Click="DeleteHistory_Click"
                        HorizontalAlignment="Left"
                        FontSize="13" Padding="12,5"/>

                <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}"/>

                <TextBlock Text="{Binding L[TagNamesSection]}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>

                <CheckBox Content="{Binding L[ShowTagNameOnIcon]}"
                          IsChecked="{Binding ShowTagNameOnIcon}"
                          FontSize="13"
                          Margin="0,0,0,4"/>
                <TextBlock Text="{Binding L[ShowTagNameOnIconNote]}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="22,0,0,8"/>

                <CheckBox Content="{Binding L[ShowTagIconOnIcon]}"
                          IsChecked="{Binding ShowTagIconOnIcon}"
                          FontSize="13"
                          Margin="0,0,0,4"/>
                <TextBlock Text="{Binding L[ShowTagIconOnIconNote]}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="22,0,0,8"/>

                <Button Content="{Binding L[EditTagNames]}"
                        Style="{StaticResource SecondaryButton}"
                        Click="EditTagNames_Click"
                        HorizontalAlignment="Left"
                        FontSize="13" Padding="12,5"/>

                <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}"/>

                <TextBlock Text="{Binding L[RefreshSection]}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>

                <CheckBox Content="{Binding L[ReopenExplorerWindowsAfterApply]}"
                          IsChecked="{Binding ReopenExplorerWindowsAfterApply}"
                          FontSize="13"
                          Margin="0,0,0,4"/>
                <TextBlock Text="{Binding L[ReopenExplorerWindowsAfterApplyNote]}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="22,0,0,0"/>

                <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}"/>

                <TextBlock Text="{Binding L[SupportSection]}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White"
                            Padding="14">
                        <StackPanel>
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M4,5 H20 V17 H8 L4,21 V5 Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding L[ContactSupportTitle]}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding L[ContactSupportDesc]}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding L[SupportLink]}"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="Support_Click"
                                        FontSize="13" Padding="12,6"
                                        Margin="0,0,8,0"/>
                                <Button Content="{Binding L[FaqTitle]}"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="Faq_Click"
                                        FontSize="13" Padding="12,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            BorderBrush="#FFE0A000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="#FFFFFAEA"
                            Padding="14">
                        <StackPanel>
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#FFFFB900"
                                          Stroke="#FF9A6A00"
                                          StrokeThickness="1.2"
                                          StrokeLineJoin="Round"
                                          Data="M12,3 L14.8,8.7 L21,9.6 L16.5,14 L17.6,20.2 L12,17.2 L6.4,20.2 L7.5,14 L3,9.6 L9.2,8.7 Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding L[RateReviewTitle]}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding L[RateReviewDesc]}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <Button Content="{Binding L[RateReview]}"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="Review_Click"
                                    HorizontalAlignment="Left"
                                    FontSize="13" Padding="12,6"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}"/>

                <TextBlock Text="{Binding L[AboutSection]}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding L[VersionLabel]}"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Width="90"/>
                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}"
                               FontSize="13"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding L[LicenseLabel]}"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Width="90"/>
                    <TextBlock Grid.Column="1" Text="{Binding LicenseText}"
                               FontSize="13" TextWrapping="Wrap"/>
                </Grid>

                <Button Content="{Binding L[LicenseInfo]}"
                        Style="{StaticResource SecondaryButton}"
                        Click="LicenseInfo_Click"
                        FontSize="13" Padding="12,5"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12"
                Background="White">
            <Button Content="{Binding L[Close]}"
                    Style="{StaticResource PrimaryButton}"
                    Click="Close_Click"
                    HorizontalAlignment="Right"
                    Padding="20,7"/>
        </Border>
    </Grid>
</Window>
