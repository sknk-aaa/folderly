<Window x:Class="Folderly.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding L[HelpWindowTitle]}"
        Width="430" Height="360"
        MinWidth="390" MinHeight="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI Variable">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,22,24,18">
            <TextBlock Text="{Binding L[HelpWindowTitle]}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBlock Text="{Binding L[HelpWindowLead]}"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

            <Button Style="{StaticResource PrimaryButton}"
                    Click="Contact_Click"
                    HorizontalContentAlignment="Stretch"
                    Padding="14,12"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="12"
                            Background="#22FFFFFF"
                            VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="White" StrokeThickness="2"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M4,5 H20 V17 H8 L4,21 V5 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding L[ContactSupportTitle]}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding L[ContactSupportDesc]}"
                                   Foreground="#EAF4FF"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{StaticResource SecondaryButton}"
                    Click="Faq_Click"
                    HorizontalContentAlignment="Stretch"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="12"
                            Background="#FFF7E0"
                            VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="#8A5A00" StrokeThickness="2"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M9,9 A3,3 0 1 1 12,12 V14 M12,18 H12.01"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding L[FaqTitle]}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding L[FaqDesc]}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12"
                Background="White">
            <Button Content="{Binding L[Close]}"
                    Style="{StaticResource SecondaryButton}"
                    Click="Close_Click"
                    HorizontalAlignment="Right"
                    Padding="18,7"/>
        </Border>
    </Grid>
</Window>
