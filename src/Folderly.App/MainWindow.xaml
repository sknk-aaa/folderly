<Window x:Class="Folderly.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Folderly.App.Infrastructure"
        Title="{Binding L[MainWindowTitle]}"
        Height="600" Width="800"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI Variable">

    <Window.Resources>
        <Style x:Key="HelpRowButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#FFC8CED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFF4F8FF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF8FB3E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFE8F1FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Background="White">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                <Button x:Name="HistoryTabBtn" Content="{Binding L[HistoryTab]}"
                        Click="HistoryTab_Click" Padding="16,10" FontSize="14"
                        Foreground="{StaticResource PrimaryBrush}"
                        Background="Transparent" BorderThickness="0,0,0,2"
                        BorderBrush="{StaticResource PrimaryBrush}"/>
                <Button x:Name="SettingsTabBtn" Content="{Binding L[SettingsTab]}"
                        Click="SettingsTab_Click" Padding="16,10" FontSize="14"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Background="Transparent" BorderThickness="0"/>
                <Button x:Name="HelpTabBtn" Content="{Binding L[HelpTab]}"
                        Click="HelpTab_Click" Padding="16,10" FontSize="14"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Background="Transparent" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid x:Name="HistoryPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding L[RecentFolders]}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="20,12,20,8"/>

                <Grid Grid.Row="1">
                    <TextBlock Text="{Binding L[NoHistory]}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Visibility="{Binding HasItems, Converter={x:Static local:BoolToInvisibility.Instance}}"/>

                    <ListView x:Name="HistoryList"
                              ItemsSource="{Binding Items}"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectionMode="Single"
                              Visibility="{Binding HasItems, Converter={x:Static local:BoolToVisibility.Instance}}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="16,10,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4"
                                            Background="#F0F0F0">
                                        <Image Source="{Binding Thumbnail}"
                                               Width="48" Height="48" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                        <TextBlock Text="{Binding FolderName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FolderPath}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,2"/>
                                        <TextBlock Text="{Binding AppliedAtText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                    Visibility="{Binding HasTag, Converter={x:Static local:BoolToVisibility.Instance}}">
                                            <Ellipse Width="9" Height="9"
                                                     Fill="{Binding TagBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding TagName}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="{Binding DataContext.L[OpenFolder], RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource SecondaryButton}"
                                            Tag="{Binding}"
                                            Click="OpenFolder_Click"
                                            Margin="0,0,8,0" Padding="12,5"/>

                                    <Button Grid.Column="3"
                                            Content="{Binding DataContext.L[RevertFolder], RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource SecondaryButton}"
                                            Tag="{Binding}"
                                            Click="Revert_Click"
                                            Padding="12,5"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="16,10">
                    <Button Content="{Binding L[ClearAllHistory]}"
                            Style="{StaticResource SecondaryButton}"
                            Click="ClearAllHistory_Click"
                            HorizontalAlignment="Left"/>
                </Border>
            </Grid>

            <ScrollViewer x:Name="SettingsPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          DataContext="{Binding SettingsContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Margin="24,20,24,24" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding L[LanguageSection]}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>

                    <RadioButton Content="{Binding L[LanguageSystem]}"
                                 IsChecked="{Binding IsSystemLang}"
                                 Margin="0,0,0,4" FontSize="13"/>
                    <RadioButton Content="{Binding L[LanguageJapanese]}"
                                 IsChecked="{Binding IsJaLang}"
                                 Margin="0,0,0,4" FontSize="13"/>
                    <RadioButton Content="{Binding L[LanguageEnglish]}"
                                 IsChecked="{Binding IsEnLang}"
                                 Margin="0,0,0,0" FontSize="13"/>

                    <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}"/>

                    <TextBlock Text="{Binding L[HistorySection]}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>

                    <Button Content="{Binding L[DeleteHistory]}"
                            Style="{StaticResource SecondaryButton}"
                            Click="ClearAllHistory_Click"
                            HorizontalAlignment="Left"
                            FontSize="13" Padding="12,5"/>

                    <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}"/>

                    <TextBlock Text="{Binding L[TagNamesSection]}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>

                    <CheckBox Content="{Binding L[ShowTagNameOnIcon]}"
                              IsChecked="{Binding ShowTagNameOnIcon}"
                              FontSize="13"
                              Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding L[ShowTagNameOnIconNote]}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="22,0,0,8"/>

                    <CheckBox Content="{Binding L[ShowTagIconOnIcon]}"
                              IsChecked="{Binding ShowTagIconOnIcon}"
                              FontSize="13"
                              Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding L[ShowTagIconOnIconNote]}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="22,0,0,8"/>

                    <Button Content="{Binding L[EditTagNames]}"
                            Style="{StaticResource SecondaryButton}"
                            Click="EditTagNames_Click"
                            HorizontalAlignment="Left"
                            FontSize="13" Padding="12,5"/>

                    <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}"/>

                    <TextBlock Text="{Binding L[RefreshSection]}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>

                    <CheckBox Content="{Binding L[ReopenExplorerWindowsAfterApply]}"
                              IsChecked="{Binding ReopenExplorerWindowsAfterApply}"
                              FontSize="13"
                              Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding L[ReopenExplorerWindowsAfterApplyNote]}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="22,0,0,0"/>

                    <Border Margin="0,18,0,0"
                            Padding="12,10"
                            Background="#FFFFFAEA"
                            BorderBrush="#FFFFD66B"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="*"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FFB07A00"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding L[ReviewInlineText]}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="4,0,16,0"/>
                            <Button Grid.Column="2"
                                    Content="{Binding L[ReviewAction]}"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="Review_Click"
                                    FontSize="13"
                                    Padding="12,5"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="HelpPanel"
                  Visibility="Collapsed"
                  DataContext="{Binding SettingsContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Margin="24,24,24,24"
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                    <Button Style="{StaticResource HelpRowButton}"
                            Click="Support_Click"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="30" Height="30"
                                    Background="#FFEAF3FF"
                                    CornerRadius="15"
                                    VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{StaticResource PrimaryBrush}"
                                              StrokeThickness="2.2"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M4,5 H20 V16 H9 L4,20 V5 Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding L[SupportLink]}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding L[HelpContactShort]}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="›"
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource HelpRowButton}"
                            Click="Faq_Click"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="30" Height="30"
                                    Background="#FFFFF4D9"
                                    CornerRadius="15"
                                    VerticalAlignment="Center">
                                <TextBlock Text="?"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#FF9A6A00"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding L[FaqTitle]}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding L[HelpFaqShort]}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="›"
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"/>
                        </Grid>
                    </Button>

                    <Separator Margin="0,0,0,16" Background="{StaticResource BorderBrush}"/>

                    <TextBlock Text="{Binding L[AboutSection]}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding L[VersionLabel]}"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                   Width="90"/>
                        <TextBlock Grid.Column="1" Text="{Binding AppVersion}"
                                   FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding L[LicenseLabel]}"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                   Width="90"/>
                        <TextBlock Grid.Column="1" Text="{Binding LicenseText}"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </Grid>

                    <Button Content="{Binding L[LicenseInfo]}"
                            Style="{StaticResource SecondaryButton}"
                            Click="LicenseInfo_Click"
                            FontSize="13"
                            Padding="12,5"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFF3CD"
                BorderBrush="#FFE69C" BorderThickness="0,1,0,0"
                Padding="16,10"
                Visibility="{Binding ShowTrialBanner, Converter={x:Static local:BoolToVisibility.Instance}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TrialText}"
                           FontSize="13" VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="{Binding L[BuyNow]}"
                        Style="{StaticResource PrimaryButton}"
                        Click="BuyNow_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
